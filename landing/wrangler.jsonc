// Cloudflare Workers: the landing page, static assets only, no server code. Headers live in _headers (copied into dist).
// Deployed by its own Cloudflare Worker build: `npm run landing:build`, then `npx wrangler deploy --config landing/wrangler.jsonc` from the repo root.
{
	"name": "lighthead-landing",
	"compatibility_date": "2026-11-17",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	// No *.workers.dev address and no preview URLs.
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "lighthead.app", "custom_domain": true }]
}
