// Cloudflare Workers: the landing page, static assets only, no server code. Headers live in _headers (copied into dist).
// Build first with `npm run landing:build`, then deploy from this folder.
{
	"name": "lighthead-landing",
	"compatibility_date": "2026-11-17",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	// No *.workers.dev address and no preview URLs.
	"workers_dev": false,
	"preview_urls": false
	// No routes yet. When switching over, add { "pattern": "lighthead.app", "custom_domain": true } here
	// and remove lighthead.app from the app's routes in ../wrangler.jsonc.
}
