// Cloudflare Workers: static assets only, no server code. Headers live in static/_headers.
{
	"name": "lighthead",
	"compatibility_date": "2026-11-17",
	"assets": {
		"directory": "./build",
		"not_found_handling": "single-page-application"
	},
	// Only the custom domains below: no *.workers.dev address and no preview URLs, so every request goes through the lighthead.app zone.
	"workers_dev": false,
	"preview_urls": false,
	// The app lives at use.lighthead.app; lighthead.app is the landing page (landing/wrangler.jsonc).
	"routes": [{ "pattern": "use.lighthead.app", "custom_domain": true }]
}
